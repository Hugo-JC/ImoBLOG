---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const explore = [
  { href: "/", label: "Artigos" },
  { href: "/#temas", label: "Temas" },
  { href: "/sobre", label: "Sobre nós" },
];
const info = [
  { href: "/privacidade", label: "Privacidade" },
  { href: "/termos", label: "Termos de utilização" },
  { href: "/#newsletter", label: "Newsletter" },
];
const linkClass =
  "rounded text-sm font-semibold text-muted underline-offset-4 transition-colors hover:text-brand hover:underline";
---

<footer class="mt-24 pb-6">
  <div class="container-wide">
    <div class="rounded-[28px] border border-line bg-surface">
      <div
        class="grid gap-10 p-8 sm:grid-cols-2 md:p-12 lg:grid-cols-[1.4fr_0.8fr_0.8fr_1.2fr]"
      >
        <div>
          <Logo tagline />
          <p class="mt-5 max-w-68 text-sm leading-7 text-muted">
            Informação clara para decisões imobiliárias mais conscientes.
          </p>
        </div>

        <nav aria-labelledby="footer-explore">
          <h2 id="footer-explore" class="text-sm font-extrabold text-ink">
            Explorar
          </h2>
          <ul class="m-0 mt-4 grid list-none gap-3 p-0">
            {
              explore.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-labelledby="footer-info">
          <h2 id="footer-info" class="text-sm font-extrabold text-ink">
            Informação
          </h2>
          <ul class="m-0 mt-4 grid list-none gap-3 p-0">
            {
              info.map((link) => (
                <li>
                  <a href={link.href} class={linkClass}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="rounded-2xl bg-tint p-6">
          <span class="eyebrow">Aprender muda tudo</span>
          <p class="mt-3 text-sm leading-7 text-muted">
            O mercado imobiliário não precisa de ser complicado. Começa por
            fazer as perguntas certas.
          </p>
          <a
            href="/#newsletter"
            class="mt-4 inline-flex min-h-11 items-center rounded-full bg-brand px-5 text-sm font-extrabold text-white transition-colors hover:bg-brand-hover dark:text-page"
            >Subscrever</a
          >
        </div>
      </div>

      <div
        class="flex flex-col gap-2 border-t border-line px-8 py-5 text-sm text-muted md:flex-row md:items-center md:justify-between md:px-12"
      >
        <span>© {year} ImoBlog. Todos os direitos reservados.</span>
        <span
          >Feito para decisões com mais confiança <span
            class="text-brand"
            aria-hidden="true">↗</span
          ></span
        >
      </div>
    </div>
  </div>
</footer>
